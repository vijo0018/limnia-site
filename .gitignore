# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# bun is the package manager here; stray npm lockfiles are accidents
package-lock.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# wrangler reads local secrets from .dev.vars — that file would hold the
# Ed25519 signing seed and the Lemon Squeezy API key in plaintext. Leaking the
# seed means anyone can mint Pro keys, and it cannot be rotated without
# stranding every paying customer.
.dev.vars
.dev.vars.*
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.design-check/
.claude/
