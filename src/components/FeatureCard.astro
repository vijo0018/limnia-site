---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div
  class="rounded-xl border border-border bg-chrome p-5 transition-colors hover:border-accent/40"
>
  <h3 class="m-0 mb-2 text-[15px] font-semibold text-text">{title}</h3>
  <p class="m-0 text-sm text-muted">
    <slot />
  </p>
</div>
