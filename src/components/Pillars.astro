---
const pillars = [
  {
    num: '01',
    title: 'Invisible until needed',
    body:
      'Clicks pass straight through a fullscreen transparent window. The tool never fights your work. It waits.',
    detail: 'alpha = 0 · click-through',
  },
  {
    num: '02',
    title: 'Instant, no delay',
    body:
      'Software-rendered, no GPU, no startup animation. Every stroke lands when your hand expects it.',
    detail: '~0 ms stroke latency',
  },
  {
    num: '03',
    title: 'Reads over anything',
    body:
      'High-contrast palette and dark chrome stay legible on white slides, dark code, photos, and video.',
    detail: 'tested on every surface',
  },
];
---

<section class="mx-auto max-w-6xl px-6 pt-24 pb-16 sm:px-10 sm:pt-32">
  {/* Section header — spec-sheet pattern */}
  <header class="mb-14 grid grid-cols-1 gap-6 md:grid-cols-12">
    <div
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint md:col-span-3"
    >
      § 01 / principles
    </div>
    <h2
      class="font-display text-[34px] font-semibold leading-[1.05] tracking-[-0.025em] text-ink sm:text-[42px] md:col-span-9"
    >
      Built for the moment you need it,
      <span class="text-ink-muted">and gone the moment you don't.</span>
    </h2>
  </header>

  {/* Asymmetric layout — each pillar has a different column span.
      The grid breaks intentionally: lead pillar gets more room,
      middle offsets right, third sits below with generous space. */}
  <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-8">
    {/* Pillar 1 — lead, wider */}
    <article
      class="md:col-span-7 md:col-start-1 md:border-r md:border-line md:pr-10"
    >
      <div
        class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint"
      >
        {pillars[0].num} / {pillars[0].detail}
      </div>
      <h3
        class="mt-3 font-display text-[28px] font-semibold leading-[1.1] tracking-[-0.02em] text-ink sm:text-[32px]"
      >
        {pillars[0].title}
      </h3>
      <p class="mt-4 max-w-lg text-[16px] leading-[1.55] text-ink-muted">
        {pillars[0].body}
      </p>
    </article>

    {/* Pillar 2 — narrower, offset right */}
    <article
      class="md:col-span-5 md:col-start-8 md:self-end"
    >
      <div
        class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint"
      >
        {pillars[1].num} / {pillars[1].detail}
      </div>
      <h3
        class="mt-3 font-display text-[24px] font-semibold leading-[1.12] tracking-[-0.02em] text-ink sm:text-[28px]"
      >
        {pillars[1].title}
      </h3>
      <p class="mt-4 text-[15.5px] leading-[1.55] text-ink-muted">
        {pillars[1].body}
      </p>
    </article>

    {/* Pillar 3 — back to left column, medium width, with a top border to reset rhythm */}
    <article
      class="mt-4 border-t border-line pt-10 md:col-span-8 md:col-start-3 md:mt-12"
    >
      <div
        class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint"
      >
        {pillars[2].num} / {pillars[2].detail}
      </div>
      <h3
        class="mt-3 font-display text-[26px] font-semibold leading-[1.1] tracking-[-0.02em] text-ink sm:text-[30px]"
      >
        {pillars[2].title}
      </h3>
      <p class="mt-4 max-w-xl text-[16px] leading-[1.55] text-ink-muted">
        {pillars[2].body}
      </p>
    </article>
  </div>
</section>
