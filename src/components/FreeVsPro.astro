---
import { CHECKOUT_URL, PRO_PRICE } from '../lib/store';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const installerHref = `${base}/downloads/LimniaSetup.exe`;
// Set the checkout URL in src/lib/store.ts and the card flips from the
// "soon" teaser to a working buy button (via /buy, same as the app's funnel).
const onSale = CHECKOUT_URL !== '';

// Free = everything shipping today except the Pro-gated tools. No version tags:
// it all ships now, and tagging features with future versions was the old
// (inaccurate) roadmap framing.
const free: string[] = [
  'All 11 drawing tools: pen, highlighter, eraser, line, arrow, rectangle, circle, text, laser, spotlight, ruler',
  'Grid overlay + eyedropper (pick any pixel on screen)',
  '14-color palette + native custom picker + 4 preset slots',
  '4 brush sizes, 20-step undo / redo',
  'PNG export + clipboard copy (canvas or composited with the screen)',
  'Multi-monitor capture with a monitor picker',
  'Named style presets (tool + color + size)',
  'Classic and Orb (radial) toolbar layouts',
  'System tray, auto-start option, per-monitor DPI',
];

// Pro = the heavier tools, deliberately kept as a small teaser.
const pro: string[] = [
  'Magnifier (live lens)',
  'Screen recording (MP4)',
  'GIF recording',
  'Region capture',
  'System / mic audio',
  'Whiteboard / Blackboard',
];
---

<section
  id="pricing"
  class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-24 pb-16 sm:px-10 sm:pt-32"
>
  <header class="mb-14 grid grid-cols-1 gap-6 md:grid-cols-12">
    <div
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint md:col-span-3"
    >
      § 03 / pricing
    </div>
    <div class="md:col-span-9">
      <h2
        class="font-display text-[34px] font-semibold leading-[1.05] tracking-[-0.025em] text-ink sm:text-[42px]"
      >
        Free is forever.
        <span class="text-ink-muted">Pro is additive.</span>
      </h2>
      <p class="mt-3 max-w-xl text-[16px] leading-[1.55] text-ink-muted">
        Everything above (all 11 drawing tools, grid, eyedropper, multi-monitor
        capture) is free, now, with no account and no catch. Pro just adds a few
        heavier tools for recording and teaching.
      </p>
    </div>
  </header>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
    {/* ─── Free — the star ─── */}
    <article class="relative flex flex-col rounded-xl border border-line bg-surface-raised md:col-span-8">
      {/* Top accent — cyan (Pen) */}
      <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-pen to-transparent"></div>

      <header class="border-b border-line px-7 pt-7 pb-6">
        <div class="flex items-center justify-between">
          <span class="font-display text-[22px] font-semibold tracking-[-0.02em] text-ink">
            Limnia <span class="text-ink-muted">Free</span>
          </span>
          <span
            class="rounded border border-pen/30 bg-pen/[0.07] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-pen"
          >
            available now
          </span>
        </div>
        <p
          class="mt-2 font-mono text-[11.5px] uppercase tracking-[0.12em] text-ink-faint"
        >
          everything that ships, forever
        </p>

        <div class="mt-7 flex items-baseline gap-1.5">
          <span
            class="font-display font-semibold tracking-[-0.04em] text-ink"
            style="font-size: clamp(56px, 8vw, 84px); line-height: 1;"
          >$0</span>
          <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-ink-faint">
            / always
          </span>
        </div>
      </header>

      <ul class="grid flex-1 grid-cols-1 gap-x-8 gap-y-2.5 px-7 pt-6 pb-7 text-[14.5px] sm:grid-cols-2">
        {free.map((f) => (
          <li class="grid grid-cols-[1.25rem_1fr] items-baseline gap-2">
            <span class="text-pen">✓</span>
            <span class="text-ink">{f}</span>
          </li>
        ))}
      </ul>

      <div class="border-t border-line px-7 pt-5 pb-6">
        <a
          href={installerHref}
          class="group flex w-full items-center justify-center gap-2 rounded-md bg-ink px-5 py-3 text-[14px] font-semibold text-surface transition-colors hover:bg-pen"
        >
          Download Free
          <span
            class="font-mono text-[11px] opacity-60 transition-transform group-hover:translate-y-0.5"
            >↓ ~2MB</span
          >
        </a>
      </div>
    </article>

    {/* ─── Pro — slim teaser, deliberately downplayed ─── */}
    <aside class="relative flex flex-col rounded-xl border border-line bg-surface-raised md:col-span-4">
      {/* Top accent — amber (Pro) */}
      <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-highlight to-transparent"></div>

      <div class="flex h-full flex-col px-7 pt-7 pb-6">
        <div class="flex items-center justify-between">
          <span class="font-display text-[19px] font-semibold tracking-[-0.02em] text-ink">
            Limnia <span class="text-highlight">Pro</span>
          </span>
          {
            !onSale && (
              <span class="rounded border border-highlight/30 bg-highlight/[0.07] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-highlight">
                soon
              </span>
            )
          }
        </div>
        <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint">
          heavier tools · one-time unlock
        </p>

        <ul class="mt-5 flex-1 space-y-2 text-[13.5px]">
          {pro.map((f) => (
            <li class="grid grid-cols-[1rem_1fr] items-baseline gap-2 text-ink-muted">
              <span class="text-highlight">+</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 border-t border-line pt-5">
          <div class="flex items-baseline gap-1.5">
            <span class="font-display text-[28px] font-semibold tracking-[-0.03em] text-ink">
              {PRO_PRICE}
            </span>
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint">
              / once
            </span>
          </div>
          {
            onSale ? (
              <>
                <a
                  href={`${base}/buy`}
                  class="group mt-4 flex w-full items-center justify-center gap-2 rounded-md bg-highlight px-5 py-2.5 text-[13.5px] font-semibold text-surface transition-opacity hover:opacity-90"
                >
                  Get Limnia Pro
                  <span class="font-mono text-[11px] opacity-70 transition-transform group-hover:translate-x-0.5">
                    ↗
                  </span>
                </a>
                <p class="mt-3 text-[12.5px] leading-[1.5] text-ink-faint">
                  Free never loses a feature to Pro.
                </p>
              </>
            ) : (
              <p class="mt-2 text-[12.5px] leading-[1.5] text-ink-faint">
                Not for sale yet. Free never loses a feature to Pro.
              </p>
            )
          }
        </div>
      </div>
    </aside>
  </div>
</section>
