---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const installerHref = `${base}/downloads/LimniaSetup.exe`;

type Feature = { v: string; text: string };

const free: Feature[] = [
  { v: 'v1.0', text: '10 drawing tools' },
  { v: 'v1.0', text: '14-color palette + custom picker' },
  { v: 'v1.0', text: '4 brush sizes, 20-step undo / redo' },
  { v: 'v1.0', text: 'PNG export + clipboard copy' },
  { v: 'v1.0', text: 'Multi-monitor capture' },
  { v: 'v1.0', text: 'System tray, auto-start option' },
  { v: 'v1.1', text: 'Eyedropper + custom color presets' },
  { v: 'v1.2', text: 'Remappable hotkeys + custom toolbar' },
  { v: 'v1.2', text: 'Shape recognition, grid, pixel ruler' },
  { v: 'v1.2', text: 'Arrow variants (double-headed, curved, dotted)' },
];

const pro: Feature[] = [
  { v: 'v2.0', text: 'Screen recording (MP4, 30 / 60 fps)' },
  { v: 'v2.0', text: 'GIF creation + freeze-frame' },
  { v: 'v2.0', text: 'Region capture + system audio' },
  { v: 'v2.0', text: 'Whiteboard + Blackboard modes' },
  { v: 'v2.0', text: 'Zoom / magnifier tool' },
  { v: 'v2.0', text: 'Stamps + shape library' },
  { v: 'v2.0', text: 'Text formatting (bold, italic, fonts)' },
  { v: 'v2.1', text: 'Webcam picture-in-picture' },
  { v: 'v2.1', text: 'Pressure sensitivity (pen, highlighter)' },
  { v: 'v2.1', text: 'Multi-page canvas + presenter timer' },
  { v: 'v2.1', text: 'Privacy blur tool' },
];
---

<section
  id="pricing"
  class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-24 pb-16 sm:px-10 sm:pt-32"
>
  <header class="mb-14 grid grid-cols-1 gap-6 md:grid-cols-12">
    <div
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint md:col-span-3"
    >
      § 03 / pricing
    </div>
    <div class="md:col-span-9">
      <h2
        class="font-display text-[34px] font-semibold leading-[1.05] tracking-[-0.025em] text-ink sm:text-[42px]"
      >
        Free is forever.
        <span class="text-ink-muted">Pro is additive.</span>
      </h2>
      <p class="mt-3 max-w-xl text-[16px] leading-[1.55] text-ink-muted">
        Every feature shipped today stays in Free, forever. Pro is a one-time
        unlock for the heavier tools teachers, streamers, and creators rely on:
        recording, region capture, whiteboard modes.
      </p>
    </div>
  </header>

  {/* Supporter perk callout — sits above the two cards.
      Anyone who donates before Pro launches gets a free Pro license. */}
  <div
    class="mb-6 grid grid-cols-1 items-center gap-4 rounded-xl border border-line bg-surface-raised px-6 py-4 sm:grid-cols-[auto_1fr_auto] sm:gap-6 sm:px-7"
  >
    <div class="flex items-center gap-2">
      <span class="text-laser" aria-hidden="true">♥</span>
      <span
        class="font-mono text-[10.5px] font-medium uppercase tracking-[0.14em] text-ink-faint"
      >
        supporter perk
      </span>
    </div>
    <p class="text-[14.5px] leading-[1.5] text-ink">
      Donate any amount on
      <a
        href="https://github.com/sponsors/vijo0018"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[13px] text-ink underline decoration-line-strong underline-offset-4 hover:text-pen hover:decoration-pen"
        >Sponsors</a
      >
      or
      <a
        href="https://ko-fi.com/vijo0018"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[13px] text-ink underline decoration-line-strong underline-offset-4 hover:text-pen hover:decoration-pen"
        >Ko-fi</a
      >
      before Pro launches.
      <span class="text-ink-muted">A Pro license is yours at launch, no extra cost.</span>
    </p>
    <span
      class="hidden font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint sm:inline"
    >
      $0 floor
    </span>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {/* ─── Free ─── */}
    <article class="relative flex flex-col rounded-xl border border-line bg-surface-raised">
      {/* Top accent — cyan (Pen) */}
      <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-pen to-transparent"></div>

      <header class="border-b border-line px-7 pt-7 pb-6">
        <div class="flex items-center justify-between">
          <span class="font-display text-[22px] font-semibold tracking-[-0.02em] text-ink">
            Limnia <span class="text-ink-muted">Free</span>
          </span>
          <span
            class="rounded border border-line bg-surface px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-pen"
          >
            available now
          </span>
        </div>
        <p
          class="mt-2 font-mono text-[11.5px] uppercase tracking-[0.12em] text-ink-faint"
        >
          everything that ships, forever
        </p>

        <div class="mt-7 flex items-baseline gap-1.5">
          <span
            class="font-display font-semibold tracking-[-0.04em] text-ink"
            style="font-size: clamp(56px, 8vw, 84px); line-height: 1;"
          >$0</span>
          <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-ink-faint">
            / always
          </span>
        </div>
      </header>

      <ul class="flex-1 space-y-2.5 px-7 pt-6 pb-7 text-[14.5px]">
        {free.map((f) => (
          <li class="grid grid-cols-[3.5rem_1fr_1.25rem] items-baseline gap-2">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-faint">
              {f.v}
            </span>
            <span class="text-ink">{f.text}</span>
            <span class="text-pen">✓</span>
          </li>
        ))}
      </ul>

      <div class="border-t border-line px-7 pt-5 pb-6">
        <a
          href={installerHref}
          class="group flex w-full items-center justify-center gap-2 rounded-md bg-ink px-5 py-3 text-[14px] font-semibold text-surface transition-colors hover:bg-pen"
        >
          Download Free
          <span
            class="font-mono text-[11px] opacity-60 transition-transform group-hover:translate-y-0.5"
            >↓ ~2MB</span
          >
        </a>
      </div>
    </article>

    {/* ─── Pro ─── */}
    <article
      class="relative flex flex-col rounded-xl border border-line bg-surface-raised"
    >
      {/* Top accent — yellow (Highlighter) */}
      <div class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-highlight to-transparent"></div>

      <header class="border-b border-line px-7 pt-7 pb-6">
        <div class="flex items-center justify-between">
          <span class="font-display text-[22px] font-semibold tracking-[-0.02em] text-ink">
            Limnia <span class="text-highlight">Pro</span>
          </span>
          <span
            class="rounded border border-highlight/30 bg-highlight/[0.07] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-highlight"
          >
            shipping Q3 2026
          </span>
        </div>
        <p
          class="mt-2 font-mono text-[11.5px] uppercase tracking-[0.12em] text-ink-faint"
        >
          heavier tools, one-time unlock
        </p>

        <div class="mt-7 flex items-baseline gap-1.5">
          <span
            class="font-display font-semibold tracking-[-0.04em] text-ink"
            style="font-size: clamp(56px, 8vw, 84px); line-height: 1;"
          >$9<span class="text-ink-muted">.99</span></span>
          <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-ink-faint">
            / once
          </span>
        </div>
      </header>

      <ul class="flex-1 space-y-2.5 px-7 pt-6 pb-7 text-[14.5px]">
        <li class="mb-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint">
          everything in free, plus:
        </li>
        {pro.map((f) => (
          <li class="grid grid-cols-[3.5rem_1fr_1.25rem] items-baseline gap-2">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-faint">
              {f.v}
            </span>
            <span class="text-ink">{f.text}</span>
            <span class="text-highlight">✓</span>
          </li>
        ))}
      </ul>

      <div class="border-t border-line px-7 pt-5 pb-6">
        {/* Waitlist form — posts to Tally.
            To activate: create a Tally form (tally.so), copy its form ID,
            and replace TALLY_FORM_ID below with the action URL Tally provides
            (e.g. https://tally.so/r/abc123). Until then the form will 404 on submit. */}
        <form
          action="https://tally.so/r/TALLY_FORM_ID"
          method="POST"
          class="group/form flex flex-col gap-2.5"
          data-waitlist
        >
          <label class="sr-only" for="waitlist-email">Email address</label>
          <div
            class="flex items-stretch overflow-hidden rounded-md border border-line bg-surface focus-within:border-highlight/60"
          >
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="min-w-0 flex-1 bg-transparent px-3.5 py-2.5 font-mono text-[13px] text-ink placeholder:text-ink-faint focus:outline-none"
            />
            {/* Honeypot — bots fill this, humans don't */}
            <input
              type="text"
              name="company"
              tabindex="-1"
              autocomplete="off"
              class="absolute h-0 w-0 opacity-0"
              aria-hidden="true"
            />
            <button
              type="submit"
              class="group/submit inline-flex items-center gap-1.5 border-l border-line bg-surface-raised px-4 text-[12.5px] font-semibold uppercase tracking-[0.1em] text-ink transition-colors hover:bg-highlight hover:text-surface"
            >
              Notify
              <span
                class="font-mono text-[11px] opacity-60 transition-transform group-hover/submit:translate-x-0.5"
                >↗</span
              >
            </button>
          </div>
          <p
            class="flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.12em] text-ink-faint"
          >
            <span class="h-1 w-1 rounded-full bg-highlight"></span>
            no spam · one email when Pro ships
          </p>
        </form>
      </div>
    </article>
  </div>
</section>
