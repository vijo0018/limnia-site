---
const year = new Date().getFullYear();
// Release date of the currently-advertised version. Update when a new tag ships.
const buildDate = '2026-04-17';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { label: 'download', href: `${base}/downloads/LimniaSetup.exe`, value: 'LimniaSetup.exe', external: false },
  { label: 'changelog', href: `${base}/changelog`, value: '/changelog', external: false },
  { label: 'about', href: `${base}/about`, value: '/about', external: false },
  { label: 'press kit', href: `${base}/press`, value: '/press', external: false },
  { label: 'report bug', href: 'https://github.com/vijo0018/limnia-site/issues', value: 'limnia-site/issues', external: true },
  { label: 'sponsor', href: 'https://github.com/sponsors/vijo0018', value: '/sponsors/vijo0018', external: true },
  { label: 'privacy', href: `${base}/privacy`, value: '/privacy', external: false },
  { label: 'terms', href: `${base}/terms`, value: '/terms', external: false },
];
---

<footer class="border-t border-line">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-12 sm:px-10 md:grid-cols-12"
  >
    {/* Build manifest — left */}
    <div class="md:col-span-5">
      <div class="font-display text-[18px] font-semibold tracking-[-0.02em] text-ink">
        Limnia
      </div>
      <dl class="mt-4 space-y-1.5 font-mono text-[12px]">
        <div class="grid grid-cols-[6.5rem_1fr] gap-2">
          <dt class="uppercase tracking-[0.12em] text-ink-faint">version</dt>
          <dd class="text-ink">v1.0.0</dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-2">
          <dt class="uppercase tracking-[0.12em] text-ink-faint">released</dt>
          <dd class="text-ink">{buildDate}</dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-2">
          <dt class="uppercase tracking-[0.12em] text-ink-faint">size</dt>
          <dd class="text-ink">~2 MB · windows x64</dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-2">
          <dt class="uppercase tracking-[0.12em] text-ink-faint">license</dt>
          <dd class="text-ink">Proprietary</dd>
        </div>
      </dl>
    </div>

    {/* Links — right, mono */}
    <nav class="md:col-span-7" aria-label="Footer">
      <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint">
        links
      </p>
      <ul class="mt-4 space-y-2 font-mono text-[12.5px]">
        {links.map((l) => (
          <li class="grid grid-cols-[6.5rem_1fr_auto] items-baseline gap-3">
            <span class="uppercase tracking-[0.12em] text-ink-faint">
              {l.label}
            </span>
            <span class="border-b border-dashed border-line"></span>
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
              class="text-ink-muted transition-colors hover:text-pen"
            >
              {l.value} <span class="opacity-50">{l.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-5 font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint sm:px-10"
    >
      <span>© {year} limnia · made in rust</span>
      <span class="flex items-center gap-1.5">
        <span class="h-1 w-1 rounded-full bg-pen"></span>
        all systems nominal
      </span>
    </div>
  </div>
</footer>
