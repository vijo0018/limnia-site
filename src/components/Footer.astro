---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div
    class="mx-auto flex max-w-5xl flex-wrap justify-between gap-3 px-6 py-8 text-xs text-muted"
  >
    <div>
      © {year} OmniDraw · MIT Licensed · Windows 10 / 11 · Made in Rust 🦀
    </div>
    <div class="flex gap-3">
      <a
        href="https://github.com/vijo0018/omnidraw"
        class="text-muted no-underline hover:text-text">GitHub</a
      >
      <span class="opacity-40">·</span>
      <a
        href="https://github.com/vijo0018/omnidraw/releases"
        class="text-muted no-underline hover:text-text">Releases</a
      >
      <span class="opacity-40">·</span>
      <a
        href="https://github.com/vijo0018/omnidraw/issues"
        class="text-muted no-underline hover:text-text">Report an issue</a
      >
    </div>
  </div>
</footer>
