---
import { APP_VERSION, INSTALLER_SIZE } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3.5 sm:px-10">
    {/* Wordmark — uses the actual product icon */}
    <a
      href={`${base}/`}
      class="group flex items-center gap-2.5"
    >
      <img src={`${base}/icon.svg`} alt="" class="h-7 w-7 rounded-md" />
      <span class="font-display text-[17px] font-semibold tracking-[-0.02em] text-ink">
        Limnia
      </span>
      <span
        class="hidden font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-ink-faint sm:inline"
      >
        {APP_VERSION} / stable
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={`${base}/#tools`}
        class="hidden rounded-md px-3 py-1.5 text-[13.5px] text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink sm:inline-block"
      >
        Tools
      </a>
      <a
        href={`${base}/#pricing`}
        class="hidden rounded-md px-3 py-1.5 text-[13.5px] text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink sm:inline-block"
      >
        Pricing
      </a>
      <a
        href={`${base}/#shortcuts`}
        class="hidden rounded-md px-3 py-1.5 text-[13.5px] text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink md:inline-block"
      >
        Shortcuts
      </a>
      <a
        href={`${base}/changelog`}
        class="hidden rounded-md px-3 py-1.5 text-[13.5px] text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink md:inline-block"
      >
        Changelog
      </a>

      <a
        href={`${base}/downloads/LimniaSetup.exe`}
        class="ml-2 inline-flex items-center gap-1.5 rounded-md bg-ink px-3.5 py-1.5 text-[13.5px] font-semibold text-surface transition-colors hover:bg-pen"
      >
        Download
        <span class="font-mono text-[10.5px] font-medium opacity-60">↓ {INSTALLER_SIZE}</span>
      </a>
    </div>
  </nav>
</header>
