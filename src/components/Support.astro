---
---

<section
  id="notify"
  class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-24 pb-24 sm:px-10 sm:pt-32"
>
  <header class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-12">
    <div
      class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint md:col-span-3"
    >
      § 06 / support
    </div>
    <h2
      class="font-display text-[34px] font-semibold leading-[1.05] tracking-[-0.025em] text-ink sm:text-[42px] md:col-span-9"
    >
      Support development.
      <span class="text-ink-muted">Free stays free.</span>
    </h2>
  </header>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="text-[16.5px] leading-[1.6] text-ink-muted">
        Limnia is free and always will be. If it earns its place in your
        workflow, a tip helps cover the
        <span class="text-ink">code-signing certificate</span> so Windows keeps
        marking the installer as safe, and pays for the cups of coffee that go
        into the next release.
      </p>

      {/* Supporter perk — same message as the pricing callout, restated here
          where the donate decision actually happens. */}
      <p
        class="mt-5 inline-flex items-baseline gap-2 rounded-md border border-laser/30 bg-laser/[0.05] px-3 py-2 text-[14px] text-ink"
      >
        <span class="text-laser" aria-hidden="true">♥</span>
        <span>
          Donate any amount before Pro launches and a
          <span class="text-ink">Pro license</span> is yours at launch. Your
          coffee tip today is a $9.99 launch gift.
        </span>
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="https://github.com/sponsors/vijo0018"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 rounded-md border border-line bg-surface-raised px-5 py-3 text-[14px] font-medium text-ink transition-colors hover:border-laser/40 hover:bg-laser/5"
        >
          <span class="text-laser">♥</span>
          Sponsor on GitHub
          <span class="font-mono text-[11px] opacity-60 transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href="https://ko-fi.com/vijo0018"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 rounded-md border border-line bg-surface-raised px-5 py-3 text-[14px] font-medium text-ink transition-colors hover:border-highlight/40 hover:bg-highlight/5"
        >
          <span class="text-highlight">☕</span>
          Buy a coffee
          <span class="font-mono text-[11px] opacity-60 transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>

    {/* Sidebar — what your money pays for, in mono */}
    <aside
      class="rounded-xl border border-line bg-surface-raised p-6 md:col-span-5"
    >
      <p
        class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint"
      >
        what tips fund
      </p>
      <ul class="mt-4 space-y-3 font-mono text-[12.5px]">
        <li class="grid grid-cols-[1.25rem_1fr] gap-2">
          <span class="text-pen">▸</span>
          <span class="text-ink">EV code-signing cert (~$300/yr)</span>
        </li>
        <li class="grid grid-cols-[1.25rem_1fr] gap-2">
          <span class="text-pen">▸</span>
          <span class="text-ink">Windows test machines</span>
        </li>
        <li class="grid grid-cols-[1.25rem_1fr] gap-2">
          <span class="text-pen">▸</span>
          <span class="text-ink">Coffee for the next release</span>
        </li>
      </ul>
    </aside>
  </div>
</section>
