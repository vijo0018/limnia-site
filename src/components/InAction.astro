---
// "See it in action" — placeholder slots that auto-swap to real assets when
// the files exist in /public. Existence checked at build time so missing
// files produce no console 404s.
//
// All four are generated by the product itself — `limnia --demo-media DIR`
// (see src/demo_media.rs in the app repo) renders them headlessly with the
// real canvas engine and the real toolbar chrome. Don't hand-edit them; they
// are regenerated, and a hand-tweaked asset would silently drift from the
// shipping UI. Copy the output over these paths and rebuild.
//
// Asset specs (drop files here, rebuild — placeholder vanishes automatically):
//   public/demo/hero-loop.mp4         — 8–12s seamless loop, ~2 MB, 960x540.
//   public/demo/hero-loop.gif           Mp4 takes priority if both present.
//   public/screenshots/in-slides.png  — 1280x800, Limnia circling a slide bullet
//   public/screenshots/in-code.png    — 1280x800, Limnia highlighting a code line
//   public/screenshots/in-video.png   — 1280x800, Limnia on a paused video frame

import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

// Resolve from the project root (Astro always builds with cwd there), not
// from import.meta.url: Vite's transformed module URLs don't reliably map
// back to the source file's directory, which made every check fail.
const publicDir = resolve(process.cwd(), 'public');
const has = (rel: string) => existsSync(resolve(publicDir, rel));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const heroMp4 = has('demo/hero-loop.mp4');
const heroGif = has('demo/hero-loop.gif');

const screenshots = [
  {
    file: 'screenshots/in-slides.png',
    label: 'on slides',
    detail: 'Circle a bullet, draw an arrow, dismiss.',
    span: 'md:col-span-7',
  },
  {
    file: 'screenshots/in-code.png',
    label: 'on code',
    detail: 'Mark a line in a review or pairing session.',
    span: 'md:col-span-5',
  },
  {
    file: 'screenshots/in-video.png',
    label: 'on a paused video',
    detail: 'Annotate a frame for tutorials.',
    span: 'md:col-span-12',
  },
].map((s) => ({ ...s, exists: has(s.file), src: `${base}/${s.file}` }));
---

<section class="mx-auto max-w-6xl px-6 pt-24 pb-16 sm:px-10 sm:pt-32">
  <header class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-12">
    <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-faint md:col-span-3">
      § / in action
    </div>
    <h2 class="font-display text-[34px] font-semibold leading-[1.05] tracking-[-0.025em] text-ink sm:text-[42px] md:col-span-9">
      Show, don't tell.
    </h2>
  </header>

  {/* Hero loop — wide aspect ratio */}
  <figure class="overflow-hidden rounded-xl border border-line bg-surface-raised">
    <div class="relative aspect-video w-full overflow-hidden">
      {/* Placeholder underlay — only seen when the asset 404s */}
      <div
        class="absolute inset-0 flex flex-col items-center justify-center gap-2"
        style="background: repeating-linear-gradient(45deg, oklch(15% 0.006 240) 0 12px, oklch(17% 0.008 240) 12px 24px);"
      >
        <span class="rounded border border-line bg-surface px-3 py-1 font-mono text-[11.5px] uppercase tracking-[0.14em] text-ink-faint">
          /demo/hero-loop · drop file to activate
        </span>
        <span class="font-mono text-[11px] text-ink-faint/70">
          8 to 12s seamless loop · about 2 MB · 16:9
        </span>
      </div>
      {/* Real asset — only rendered if the file exists at build time, so
          there are no console 404s while waiting for assets. MP4 wins over
          GIF when both exist (smaller, autoplay-friendly). */}
      {heroMp4 && (
        <video
          src={`${base}/demo/hero-loop.mp4`}
          autoplay loop muted playsinline
          class="absolute inset-0 h-full w-full object-cover"
        ></video>
      )}
      {!heroMp4 && heroGif && (
        <img
          src={`${base}/demo/hero-loop.gif`}
          alt="Limnia's toolbar sits above a slide while a red circle and arrow are drawn around a bullet, a line is highlighted, then the canvas clears"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
    </div>
    <figcaption class="flex items-center justify-between border-t border-line px-5 py-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-faint">
      <span class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-pen"></span>
        drawn by limnia's engine
      </span>
      <span>toggle · annotate · vanish</span>
    </figcaption>
  </figure>

  {/* In-context screenshots — asymmetric grid, each with the same auto-swap pattern */}
  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-12">
    {screenshots.map((s) => (
      <figure class:list={['overflow-hidden rounded-xl border border-line bg-surface-raised', s.span]}>
        <div class="relative aspect-[16/10] w-full overflow-hidden">
          <div
            class="absolute inset-0 flex flex-col items-center justify-center gap-1.5"
            style="background: repeating-linear-gradient(45deg, oklch(15% 0.006 240) 0 10px, oklch(17% 0.008 240) 10px 20px);"
          >
            <span class="rounded border border-line bg-surface px-2.5 py-1 font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint">
              /{s.file}
            </span>
            <span class="font-mono text-[10.5px] text-ink-faint/70">drop file to activate</span>
          </div>
          {s.exists && (
            <img
              src={s.src}
              alt={`Limnia ${s.label}`}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
          )}
        </div>
        <figcaption class="px-5 py-3.5">
          <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-faint">
            {s.label}
          </p>
          <p class="mt-1 text-[14px] leading-[1.4] text-ink">{s.detail}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
