---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OmniDraw — Draw on your screen, instantly.',
  description = 'A lightweight, transparent screen overlay drawing tool for Windows. Press a hotkey, annotate anything — slides, code, videos — then vanish.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content="OmniDraw" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vijo0018.github.io/omnidraw-site/" />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
  </head>
  <body class="min-h-screen">
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
