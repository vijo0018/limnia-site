---
import '../styles/global.css';
import MacBanner from '../components/MacBanner.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Limnia · Draw on your screen, instantly.',
  description = 'A 2 MB Windows overlay for presenters, educators, and creators. Press a hotkey, annotate any pixel, vanish.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content="Limnia · Draw on your screen, instantly." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vijo0018.github.io/limnia-site/" />
    <meta property="og:image" content={`https://vijo0018.github.io${base}/og.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://vijo0018.github.io${base}/og.svg`} />

    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
  </head>
  <body class="min-h-screen relative">
    <MacBanner />
    <Nav />
    <slot />
    <Footer />

    {/* Interactive demo overlay — the signature moment.
        Press Ctrl+Shift+D anywhere on the page to activate. */}
    <canvas class="draw-canvas" aria-hidden="true"></canvas>
    <div class="draw-status" role="status" aria-live="polite">
      <span class="dot" aria-hidden="true"></span>
      <span>DRAW MODE</span>
      <span style="opacity:0.45">·</span>
      <span><kbd>esc</kbd> to exit</span>
    </div>

    <script>
      const canvas = document.querySelector('.draw-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const dpr = Math.max(window.devicePixelRatio || 1, 1);
      let active = false;
      let drawing = false;
      let last: { x: number; y: number } | null = null;

      function resize() {
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        canvas.style.width = window.innerWidth + 'px';
        canvas.style.height = window.innerHeight + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#32b4ff';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#32b4ff';
        ctx.shadowBlur = 6;
      }

      function activate() {
        active = true;
        document.body.classList.add('drawing-mode');
      }

      function deactivate() {
        active = false;
        drawing = false;
        last = null;
        document.body.classList.remove('drawing-mode');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }

      window.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.shiftKey && (e.key === 'D' || e.key === 'd')) {
          e.preventDefault();
          active ? deactivate() : activate();
        } else if (e.key === 'Escape' && active) {
          deactivate();
        }
      });

      canvas.addEventListener('pointerdown', (e) => {
        if (!active) return;
        drawing = true;
        last = { x: e.clientX, y: e.clientY };
        canvas.setPointerCapture(e.pointerId);
      });

      canvas.addEventListener('pointermove', (e) => {
        if (!drawing || !last) return;
        const p = { x: e.clientX, y: e.clientY };
        ctx.beginPath();
        ctx.moveTo(last.x, last.y);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        last = p;
      });

      const stopDraw = (e: PointerEvent) => {
        drawing = false;
        last = null;
        try { canvas.releasePointerCapture(e.pointerId); } catch {}
      };
      canvas.addEventListener('pointerup', stopDraw);
      canvas.addEventListener('pointercancel', stopDraw);

      window.addEventListener('resize', resize);
      resize();

      (window as any).limniaDemo = {
        activate, deactivate,
        toggle: () => active ? deactivate() : activate(),
      };
    </script>
  </body>
</html>
