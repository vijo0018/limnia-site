---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InAction from '../components/InAction.astro';
import Pillars from '../components/Pillars.astro';
import ToolsToolbar from '../components/ToolsToolbar.astro';
import FreeVsPro from '../components/FreeVsPro.astro';
import ShortcutsTable from '../components/ShortcutsTable.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Support from '../components/Support.astro';
---

<Layout>
  <main class="relative z-10">
    <Hero />
    <InAction />
    <Pillars />
    <ToolsToolbar />
    <FreeVsPro />
    <ShortcutsTable />
    <HowItWorks />
    <Support />
  </main>
</Layout>
